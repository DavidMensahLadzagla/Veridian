# Veridian environment — copy to .env and fill in. NEVER commit .env (see .gitignore).
# Secrets marked (SECRET) must come from a vault in staging/prod, not this file.

# --- Django core ---
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-in-every-environment          # (SECRET) rotate per threat model
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (Supabase Postgres via PgBouncer) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/veridian

# --- Redis (cache, Celery broker, rate limits, role cache) ---
REDIS_URL=redis://localhost:6379/0

# --- JWT (ADR-0001: RS256; public key published as JWKS for Supabase third-party auth) ---
JWT_PRIVATE_KEY=                                          # (SECRET) PEM, RS256 signing key
JWT_PUBLIC_KEY=                                           # PEM, used to build /.well-known/jwks.json

# --- Health-record encryption (per-patient HKDF from this master key) ---
HEALTH_RECORD_MASTER_KEY=                                 # (SECRET) 32 bytes, base64

# --- Supabase ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=                                # (SECRET) server-only; bypasses RLS

# --- Third-party providers (Phase 1+) ---
PAYSTACK_SECRET_KEY=                                      # (SECRET)
TERMII_API_KEY=                                           # (SECRET)
DAILY_API_KEY=                                            # (SECRET) telehealth (v1.1)
OPENAI_API_KEY=                                           # (SECRET) semantic search (v1.3)
SENTRY_DSN=
